#!/bin/sh

ROOT="$(git rev-parse --show-toplevel)"
LOG="$ROOT/CHANGELOG.md"
MESSAGE_FILE="$1"
SUMMARY="$(head -n 1 "$MESSAGE_FILE")"
STAMP="$(date '+%Y-%m-%d %H:%M:%S %z')"

{
  printf '\n## %s · %s\n\n' "$STAMP" "$SUMMARY"
  printf '%s\n' '- 本次提交涉及文件：'
  git diff --cached --name-only | sed 's/^/- /'
} >> "$LOG"

git add "$LOG"
